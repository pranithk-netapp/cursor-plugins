{
  "name": "open-api-viewer",
  "displayName": "OpenAPI Viewer & Reviewer",
  "description": "Offline review, editing and security auditing of OpenAPI 3.0/3.1 specs: live Swagger UI preview, outline navigation, diagnostics and a 42Crunch-style audit report.",
  "version": "0.3.0",
  "publisher": "pranithk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pranithk-netapp/cursor-plugins.git"
  },
  "homepage": "https://github.com/pranithk-netapp/cursor-plugins",
  "bugs": {
    "url": "https://github.com/pranithk-netapp/cursor-plugins/issues"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "openapi",
    "swagger",
    "api",
    "lint",
    "security",
    "audit"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openapiViewer",
          "title": "OpenAPI",
          "icon": "media/icons/openapi.svg"
        }
      ]
    },
    "views": {
      "openapiViewer": [
        {
          "id": "openapiViewer.outline",
          "name": "Outline",
          "when": "openapiViewer.isOpenApi"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "openapiViewer.outline",
        "contents": "The active editor is not an OpenAPI document.\nOpen a JSON or YAML file describing an OpenAPI 3.0/3.1 spec to see its outline here.",
        "when": "!openapiViewer.isOpenApi"
      }
    ],
    "commands": [
      {
        "command": "openapiViewer.showInfo",
        "title": "OpenAPI Viewer: Show Info",
        "category": "OpenAPI"
      },
      {
        "command": "openapiViewer.outline.filter",
        "title": "Filter",
        "category": "OpenAPI",
        "icon": "$(filter)"
      },
      {
        "command": "openapiViewer.outline.clearFilter",
        "title": "Clear Filter",
        "category": "OpenAPI",
        "icon": "$(clear-all)"
      },
      {
        "command": "openapiViewer.outline.refresh",
        "title": "Refresh",
        "category": "OpenAPI",
        "icon": "$(refresh)"
      },
      {
        "command": "openapiViewer.revealRange",
        "title": "OpenAPI Viewer: Reveal Range"
      },
      {
        "command": "openapiViewer.preview",
        "title": "OpenAPI: Preview (Swagger UI)",
        "category": "OpenAPI",
        "icon": "media/icons/preview-badge.svg"
      },
      {
        "command": "openapiViewer.runAudit",
        "title": "OpenAPI: Run Audit",
        "category": "OpenAPI",
        "icon": "$(shield)"
      },
      {
        "command": "openapiViewer.addPath",
        "title": "OpenAPI: Add Path",
        "category": "OpenAPI",
        "icon": "$(add)"
      },
      {
        "command": "openapiViewer.addOperation",
        "title": "OpenAPI: Add Operation",
        "category": "OpenAPI"
      },
      {
        "command": "openapiViewer.addSchema",
        "title": "OpenAPI: Add Schema",
        "category": "OpenAPI"
      },
      {
        "command": "openapiViewer.addResponse",
        "title": "OpenAPI: Add Response",
        "category": "OpenAPI"
      },
      {
        "command": "openapiViewer.copyJsonPointer",
        "title": "OpenAPI: Copy JSON Pointer",
        "category": "OpenAPI"
      },
      {
        "command": "openapiViewer.tryOperation",
        "title": "OpenAPI: Try it",
        "category": "OpenAPI"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "openapiViewer.revealRange",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "openapiViewer.preview",
          "when": "openapiViewer.isOpenApi",
          "group": "navigation"
        },
        {
          "command": "openapiViewer.runAudit",
          "when": "openapiViewer.isOpenApi",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "openapiViewer.copyJsonPointer",
          "when": "openapiViewer.isOpenApi",
          "group": "9_cutcopypaste"
        }
      ],
      "view/title": [
        {
          "command": "openapiViewer.outline.filter",
          "when": "view == openapiViewer.outline && !openapiViewer.outlineFiltered",
          "group": "navigation"
        },
        {
          "command": "openapiViewer.outline.clearFilter",
          "when": "view == openapiViewer.outline && openapiViewer.outlineFiltered",
          "group": "navigation"
        },
        {
          "command": "openapiViewer.outline.refresh",
          "when": "view == openapiViewer.outline",
          "group": "navigation"
        },
        {
          "command": "openapiViewer.runAudit",
          "when": "view == openapiViewer.outline",
          "group": "navigation"
        },
        {
          "command": "openapiViewer.addPath",
          "when": "view == openapiViewer.outline",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "openapiViewer.addOperation",
          "when": "view == openapiViewer.outline && viewItem == path",
          "group": "inline"
        },
        {
          "command": "openapiViewer.addResponse",
          "when": "view == openapiViewer.outline && viewItem == operation",
          "group": "inline"
        }
      ]
    },
    "snippets": [
      {
        "language": "json",
        "path": "./snippets/openapi-json.json"
      },
      {
        "language": "jsonc",
        "path": "./snippets/openapi-json.json"
      },
      {
        "language": "yaml",
        "path": "./snippets/openapi-yaml.json"
      }
    ],
    "configuration": {
      "title": "OpenAPI Viewer",
      "properties": {
        "openapiViewer.validation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable schema and semantic (OAV1xx) validation diagnostics for OpenAPI documents."
        },
        "openapiViewer.validation.missingDescriptions": {
          "type": "string",
          "enum": [
            "off",
            "info",
            "warning"
          ],
          "default": "info",
          "description": "Severity for missing info.description / operation description+summary (rule OAV108). 'off' disables the rule."
        },
        "openapiViewer.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 50,
          "description": "Milliseconds to debounce re-analysis after an edit to an OpenAPI document."
        },
        "openapiViewer.audit.runOn": {
          "type": "string",
          "enum": [
            "manual",
            "save",
            "type"
          ],
          "default": "save",
          "description": "When to automatically recompute the audit diagnostics collection: 'manual' only via the OpenAPI: Run Audit command, 'save' on save, or 'type' on every debounced edit. The Run Audit command always works regardless of this setting."
        },
        "openapiViewer.audit.ruleSeverity": {
          "type": "object",
          "default": {},
          "description": "Per-rule audit overrides. Keys are rule ids (e.g. SEC001, DV004, QF002); values are 'off' (disable the rule and redistribute its weight within its category) or a replacement severity: 'critical', 'high', 'medium' or 'low'."
        },
        "openapiViewer.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a '▶ Try it' CodeLens above each operation in an OpenAPI document."
        },
        "openapiViewer.tryIt.defaultServerUrl": {
          "type": "string",
          "default": "",
          "description": "When non-empty, used as the initial server URL for new Try-it panels instead of the spec's first server."
        },
        "openapiViewer.tryIt.timeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "Timeout in milliseconds for Try-it requests sent from the extension host."
        },
        "openapiViewer.tryIt.allowInsecure": {
          "type": "boolean",
          "default": false,
          "description": "Skip the confirmation prompt before sending a Try-it request to a non-localhost http:// URL."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile:production",
    "compile": "tsc --noEmit -p . && node esbuild.mjs",
    "compile:production": "tsc --noEmit -p . && node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "test:unit": "tsc -p tsconfig.test.json && mocha --ui tdd \"out/test/unit/**/*.test.js\"",
    "test": "npm run compile && npm run test:unit && node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.92.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.24.0",
    "glob": "^11.0.3",
    "mocha": "^11.7.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsonc-parser": "^3.3.1",
    "swagger-ui-dist": "^5.33.0",
    "yaml": "^2.9.1"
  }
}
